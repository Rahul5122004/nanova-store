PORT=5000
NODE_ENV=development
JWT_SECRET=nanova_jwt_secret_token_key_2026_super_secure
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL / MariaDB)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nanova_db

# Fallback SQLite Path if MySQL is not available
SQLITE_PATH=./data/nanova.sqlite

# First-time Super Admin Setup Secret Key
ADMIN_SETUP_KEY=nanova_setup_admin_key_2026

# SMTP Configuration for Owner Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
